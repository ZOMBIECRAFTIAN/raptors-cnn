# ============================================================================
# .env.example - Plantilla de variables de entorno
# ----------------------------------------------------------------------------
# COMO USAR:
#   1. Copia este archivo y renombralo a ".env"  (sin el .example):
#         cp .env.example .env       (macOS/Linux)
#         copy .env.example .env     (Windows cmd)
#         Copy-Item .env.example .env  (PowerShell)
#
#   2. Edita .env y reemplaza los placeholders con tus credenciales reales.
#
#   3. NUNCA committees .env a git -- ya esta en .gitignore.
#
#   4. Las variables se cargan en Python con:
#         from dotenv import load_dotenv
#         load_dotenv()
#         import os; key = os.getenv("EBIRD_API_KEY")
# ============================================================================

# eBird API key (obten una en https://ebird.org/api/keygen)
EBIRD_API_KEY=tu_api_key_aqui

# Weights & Biases (opcional, para tracking de experimentos)
# Obten token en https://wandb.ai/authorize
WANDB_API_KEY=

# Hugging Face token (opcional, para subir modelos a Hub)
# Obten en https://huggingface.co/settings/tokens
HF_TOKEN=
