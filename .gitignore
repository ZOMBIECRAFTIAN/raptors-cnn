# ============================================================================
# .gitignore para el proyecto raptors-cnn
# ============================================================================

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.coverage
coverage.xml
htmlcov/

# Entornos virtuales
.venv/
venv/
env/
ENV/
.conda/
conda-meta/

# Notebooks (mantener .ipynb pero ignorar checkpoints)
.ipynb_checkpoints/
profile_default/
ipython_config.py
*.nbconvert.ipynb

# ----- Datasets (no se commitean imágenes; pesan demasiado) -----
datos/raw/
datos/processed/
datos/annotations/*.csv
datos/feedback/*
!datos/feedback/.gitkeep
!datos/feedback/README.md
datos/observations/
datos/videos/raw/
datos/videos/processed/
datos/videos/annotations/*.csv
# Sí commitear el README y la guía de fuentes
!datos/README.md
!datos/FUENTES_DE_IMAGENES.md
!datos/videos/README.md

# ----- Modelos entrenados y artefactos de entrenamiento -----
codigo/pytorch/outputs/*
codigo/tensorflow/outputs/*
!codigo/pytorch/outputs/.gitkeep
!codigo/tensorflow/outputs/.gitkeep
codigo/pytorch/app_flask/uploads/
codigo/pytorch/app_flask/static/behavior_videos/*
codigo/pytorch/app_flask/static/is_videos/*
codigo/pytorch/app_flask/static/auslan_videos/*
!codigo/pytorch/app_flask/static/behavior_videos/.gitkeep
!codigo/pytorch/app_flask/static/is_videos/.gitkeep
!codigo/pytorch/app_flask/static/auslan_videos/.gitkeep
*.pt
*.pth
*.ckpt
*.h5
*.keras
*.tflite
*.onnx
*.pkl
*.pickle
*.joblib
*.npy
*.npz
*.parquet

# Permitir que la estructura de outputs/ exista en el repo con un .gitkeep
!codigo/pytorch/outputs/.gitkeep
!codigo/tensorflow/outputs/.gitkeep

# ----- Logs y tracking -----
mlruns/
wandb/
runs/
tb_logs/
lightning_logs/
*.log
*.sqlite
*.sqlite3
*.db
instance/

# ----- IDE / editores -----
# Mantener .vscode con la configuración compartida del proyecto
# Ignorar archivos personales del editor
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ----- Documentos temporales o externos al proyecto -----
# Archivo viejo no relacionado con el proyecto actual
Tesis Biologia.docx
# Backups generados por Word, Excel, etc.
~$*
*.tmp
*.bak
*.orig
*.rej

# ----- Archivos huerfanos creados accidentalmente desde la consola -----
# (ej: cuando un comando 'python X | Ibycter' tipea mal y crea archivos vacios)
/Ibycter
/Astur
/Daptrius
/Pseudastur
/Geranoaetus
/Rupornis
/Buteogallus
/Spizaetus
/Falco
/Harpagus
/Morphnus

# ----- OneDrive / Google Drive -----
.dropbox
.dropbox.attr
.dropbox.cache

# ----- Variables de entorno (NUNCA commit) -----
.env
.env.local
*.pem
*.key
secrets/

# ----- Construcción de documentos / LaTeX si aplica -----
*.aux
*.fdb_latexmk
*.fls
*.synctex.gz
*.toc
*.bbl
*.blg
